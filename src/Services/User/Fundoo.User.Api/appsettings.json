{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact",
      "Fundoo.Observability"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Debug",
        "Microsoft.IdentityModel": "Debug",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/user-readable-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true,
          "formatter": "Fundoo.Observability.IndentedJsonFormatter, Fundoo.Observability"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "ExpiryMinutes": 30
  },
  "Notification": {
    "BaseUrl": "http://localhost:5134/"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  }

  //Your current .NET application runs directly on Windows, while Kafka runs inside Docker. The published host port allows the application to connect using localhost:9092.
}
