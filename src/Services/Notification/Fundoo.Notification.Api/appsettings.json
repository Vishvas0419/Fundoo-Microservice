{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "UserRegisteredTopic": "user-registered", //topic to be consumed
    "GroupId": "fundoo-notification-service"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact",
      "Fundoo.Observability"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/notification-readable-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true,
          "formatter": "Fundoo.Observability.IndentedJsonFormatter, Fundoo.Observability"
        }
      }
    ]
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "vishvasvaglay@gmail.com",
    "FromEmail": "vishvasvaglay@gmail.com",
    "FromName": "Fundoo"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
